// Prisma Schema for ROA - Roots Online Academy
// Multi-creator martial arts LMS with subscription-based access

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum Role {
  STUDENT
  COACH
  ADMIN
}

// Subscription status enum
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

// Course disciplines/categories
enum Discipline {
  MMA
  KICKBOXING
  GRAPPLING
}

// Course status
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Content language
enum Language {
  EN  // English
  DE  // German (Deutsch)
  ES  // Spanish
  PT  // Portuguese
  FR  // French
}

// User model - synced with Clerk
model User {
  id                    String             @id @default(cuid())
  clerkId               String             @unique
  email                 String             @unique
  firstName             String?
  lastName              String?
  imageUrl              String?
  role                  Role               @default(STUDENT)

  // Onboarding fields
  onboardingCompleted   Boolean            @default(false)
  experienceLevel       String?            // BEGINNER, INTERMEDIATE, ADVANCED
  trainingGoals         String?            @db.Text // JSON array of goals
  preferredDisciplines  String?            @db.Text // JSON array of disciplines

  // Stripe subscription fields
  stripeCustomerId      String?            @unique
  subscriptionStatus    SubscriptionStatus @default(INACTIVE)
  subscriptionId        String?            @unique
  subscriptionPriceId   String?
  subscriptionEndsAt    DateTime?

  // Relations
  coursesCreated        Course[]           @relation("CourseCreator")
  lessonProgress        LessonProgress[]

  // Training footage relations
  trainingFootage       TrainingFootage[]  @relation("MemberFootage")
  feedbackGiven         VideoFeedback[]    @relation("CoachFeedback")

  // Feature relations
  bookmarks             Bookmark[]
  notes                 LessonNote[]
  certificates          Certificate[]
  streaks               TrainingStreak[]
  referralsSent         Referral[]         @relation("ReferralSender")
  referredBy            Referral?          @relation("ReferredUser")

  // Gamification relations
  belts                 UserBelt[]
  achievements          UserAchievement[]

  // Q&A session relations
  qaSessionsAsStudent   QASession[]        @relation("StudentSessions")
  qaSessionsAsCoach     QASession[]        @relation("CoachSessions")
  coachAvailability     CoachAvailability[] @relation("CoachAvailability")

  // Learning path and quiz relations
  learningPathEnrollments LearningPathEnrollment[]
  quizAttempts          QuizAttempt[]

  // Course purchases (one-time purchases)
  coursePurchases       CoursePurchase[]

  // Push notification subscription
  pushSubscription      PushSubscription?

  // Affiliate and gift relations
  affiliate             Affiliate?
  giftsPurchased        GiftSubscription[] @relation("GiftPurchaser")
  giftsReceived         GiftSubscription[] @relation("GiftRecipient")

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// Course model - created by coaches
model Course {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  description     String       @db.Text
  shortDescription String?     @db.VarChar(300)
  coverImage      String?
  previewVideoUrl String?      // Optional free preview video

  discipline      Discipline
  language        Language     @default(EN)
  status          CourseStatus @default(DRAFT)
  featured        Boolean      @default(false)

  // Pricing - for individual course sales (in cents EUR)
  price           Int?         // One-time purchase price in cents (e.g., 4999 = €49.99)
  stripePriceId   String?      // Stripe Price ID for one-time purchase

  // Coach/Creator relation
  coachId         String
  coach           User         @relation("CourseCreator", fields: [coachId], references: [id], onDelete: Cascade)

  // Modules within this course
  modules         Module[]

  // Feature relations
  certificates    Certificate[]
  learningPathItems LearningPathItem[]
  purchases       CoursePurchase[]

  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  publishedAt     DateTime?

  @@index([discipline])
  @@index([language])
  @@index([status])
  @@index([coachId])
}

// Individual course purchase tracking
model CoursePurchase {
  id                String   @id @default(cuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Payment details
  amountPaid        Int      // Amount in cents EUR
  stripePaymentId   String?  // Stripe PaymentIntent ID

  createdAt         DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// Module model - sections within a course
model Module {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  order       Int      @default(0)

  // Course relation
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Lessons within this module
  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

// Lesson model - individual videos/content
model Lesson {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  order           Int      @default(0)

  // Video fields
  videoUrl        String?  // Cloudinary URL or external embed
  videoPublicId   String?  // Cloudinary public ID for signed URLs
  videoDuration   Int?     // Duration in seconds
  videoProvider   String   @default("cloudinary") // cloudinary, vimeo, youtube

  // Content flags
  isFreePreview   Boolean  @default(false) // Allow non-subscribers to view
  isPublished     Boolean  @default(false)

  // Module relation
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Progress tracking
  progress        LessonProgress[]

  // Feature relations
  bookmarks       Bookmark[]
  notes           LessonNote[]
  tags            LessonTag[]
  quizzes         Quiz[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([moduleId])
}

// Lesson progress tracking
model LessonProgress {
  id            String   @id @default(cuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Progress data
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  completedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// Training footage submission status
enum SubmissionStatus {
  PENDING    // Waiting for coach review
  REVIEWED   // Coach has provided feedback
  ARCHIVED   // Old/archived submission
}

// Training footage uploaded by members for feedback
model TrainingFootage {
  id              String           @id @default(cuid())
  title           String
  description     String?          @db.Text

  // Video fields
  videoUrl        String
  videoPublicId   String?          // Cloudinary public ID
  videoDuration   Int?             // Duration in seconds
  thumbnailUrl    String?

  // Category
  discipline      Discipline

  // Status
  status          SubmissionStatus @default(PENDING)

  // Member who submitted
  memberId        String
  member          User             @relation("MemberFootage", fields: [memberId], references: [id], onDelete: Cascade)

  // Feedback from coaches
  feedback        VideoFeedback[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([discipline])
}

// Coach feedback on training footage
model VideoFeedback {
  id              String           @id @default(cuid())

  // The footage being reviewed
  footageId       String
  footage         TrainingFootage  @relation(fields: [footageId], references: [id], onDelete: Cascade)

  // Coach providing feedback
  coachId         String
  coach           User             @relation("CoachFeedback", fields: [coachId], references: [id], onDelete: Cascade)

  // Feedback content
  content         String           @db.Text      // Written feedback
  videoUrl        String?                        // Optional video response
  videoPublicId   String?                        // Cloudinary public ID

  // Timestamps for specific moments (JSON array of {time: number, note: string})
  timestamps      String?          @db.Text      // JSON string of timestamped notes

  // Rating (optional)
  rating          Int?                           // 1-5 stars

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([footageId])
  @@index([coachId])
}

// Bookmarked lessons with timestamps
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  timestamp Int?     // Video timestamp in seconds (null for lesson-level bookmark)
  label     String?  // Optional label/description for the bookmark
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

// User notes on lessons
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  timestamp Int?     // Video timestamp in seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([lessonId])
}

// Course completion certificates
model Certificate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateNumber String @unique
  completedAt  DateTime @default(now())
  pdfUrl       String?

  @@unique([userId, courseId])
  @@index([userId])
}

// Daily training streaks
model TrainingStreak {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId])
}

// Referral tracking
model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        User     @relation("ReferralSender", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId  String?  @unique
  referredUser    User?    @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  referralCode    String   @unique
  rewardClaimed   Boolean  @default(false)
  rewardAmount    Int      @default(20) // €20 reward
  status          String   @default("PENDING") // PENDING, COMPLETED, EXPIRED
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([referrerId])
  @@index([referralCode])
}

// Technique tags for lessons
model TechniqueTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  discipline  Discipline
  description String?
  lessons     LessonTag[]
  createdAt   DateTime @default(now())

  @@index([discipline])
}

// Junction table for lesson-technique relationships
model LessonTag {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tagId       String
  tag         TechniqueTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([lessonId, tagId])
  @@index([lessonId])
  @@index([tagId])
}

// Belt ranks for progression
enum BeltColor {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

model UserBelt {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline  Discipline
  belt        BeltColor  @default(WHITE)
  stripes     Int        @default(0) // 0-4 stripes per belt
  awardedAt   DateTime   @default(now())
  awardedBy   String?    // Coach who awarded the belt
  notes       String?

  @@unique([userId, discipline])
  @@index([userId])
}

// Achievement definitions
model Achievement {
  id           String            @id @default(cuid())
  name         String            @unique
  slug         String            @unique
  description  String
  icon         String            // Emoji or icon name
  category     String            // STREAK, PROGRESS, SPECIAL
  requirement  Int               @default(1) // e.g., 7 for 7-day streak
  points       Int               @default(10)
  userAchievements UserAchievement[]
  createdAt    DateTime          @default(now())

  @@index([category])
}

// User earned achievements
model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

// Coach Q&A session bookings
enum QASessionStatus {
  PENDING       // Waiting for coach confirmation
  CONFIRMED     // Coach confirmed
  COMPLETED     // Session happened
  CANCELLED     // Cancelled by either party
}

model QASession {
  id            String          @id @default(cuid())

  // Student who booked
  studentId     String
  student       User            @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)

  // Coach who will answer
  coachId       String
  coach         User            @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)

  // Session details
  topic         String          // What they want to discuss
  questions     String          @db.Text // Pre-submitted questions
  scheduledAt   DateTime        // When the session is scheduled
  duration      Int             @default(30) // Duration in minutes (15, 30, 60)

  // Status
  status        QASessionStatus @default(PENDING)

  // Communication
  meetingUrl    String?         // Video call link (Zoom, Meet, etc.)
  notes         String?         @db.Text // Coach notes after session

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([studentId])
  @@index([coachId])
  @@index([status])
  @@index([scheduledAt])
}

// Coach availability slots
model CoachAvailability {
  id          String   @id @default(cuid())
  coachId     String
  coach       User     @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)

  // Day and time (recurring weekly)
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, etc.
  startTime   String   // "09:00" format
  endTime     String   // "17:00" format

  // Pricing (in cents)
  price15min  Int      @default(2500)  // €25
  price30min  Int      @default(4500)  // €45
  price60min  Int      @default(7500)  // €75

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([coachId, dayOfWeek])
  @@index([coachId])
}

// Promo codes for discounts
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountType    String    @default("PERCENT") // PERCENT or FIXED
  discountAmount  Int       // Percentage (0-100) or fixed amount in cents
  maxUses         Int?      // null = unlimited
  usedCount       Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// Learning paths - curated course sequences
model LearningPath {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String            @db.Text
  coverImage      String?
  discipline      Discipline
  difficulty      String            @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  estimatedWeeks  Int               @default(4) // Estimated completion time
  isPublished     Boolean           @default(false)

  // Path items (courses in order)
  items           LearningPathItem[]

  // User enrollments
  enrollments     LearningPathEnrollment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([discipline])
  @@index([isPublished])
}

// Courses within a learning path
model LearningPathItem {
  id              String        @id @default(cuid())
  learningPathId  String
  learningPath    LearningPath  @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Int           @default(0)
  isRequired      Boolean       @default(true) // Optional courses for extra credit

  @@unique([learningPathId, courseId])
  @@index([learningPathId])
  @@index([courseId])
}

// User enrollment in learning paths
model LearningPathEnrollment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPathId  String
  learningPath    LearningPath  @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?

  @@unique([userId, learningPathId])
  @@index([userId])
  @@index([learningPathId])
}

// Technique quizzes for lessons
model Quiz {
  id              String        @id @default(cuid())
  lessonId        String
  lesson          Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  passingScore    Int           @default(70) // Percentage required to pass

  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([lessonId])
}

model QuizQuestion {
  id              String        @id @default(cuid())
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question        String        @db.Text
  imageUrl        String?       // Optional image for the question
  order           Int           @default(0)

  options         QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id              String        @id @default(cuid())
  questionId      String
  question        QuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text            String
  isCorrect       Boolean       @default(false)
  explanation     String?       // Explanation shown after answering

  @@index([questionId])
}

model QuizAttempt {
  id              String        @id @default(cuid())
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           Int           // Percentage score
  passed          Boolean
  answers         String        @db.Text // JSON of answers
  completedAt     DateTime      @default(now())

  @@index([quizId])
  @@index([userId])
}

// Push notification subscriptions
model PushSubscription {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint                String   @db.Text
  p256dh                  String
  auth                    String

  // Notification preferences
  newCourseNotifications  Boolean  @default(true)
  feedbackNotifications   Boolean  @default(true)
  reminderNotifications   Boolean  @default(true)
  marketingNotifications  Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

// Affiliate program
model Affiliate {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateCode     String            @unique
  commissionRate    Int               @default(20) // Percentage
  status            String            @default("PENDING") // PENDING, ACTIVE, SUSPENDED

  // Payout info
  paypalEmail       String?
  bankDetails       String?           @db.Text // Encrypted JSON

  // Stats
  totalReferrals    Int               @default(0)
  totalEarnings     Int               @default(0) // In cents
  pendingPayout     Int               @default(0) // In cents
  paidOut           Int               @default(0) // In cents

  // Relations
  conversions       AffiliateConversion[]
  payouts           AffiliatePayout[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([affiliateCode])
  @@index([status])
}

// Track affiliate conversions
model AffiliateConversion {
  id                String    @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId    String?
  subscriptionId    String?
  amount            Int       // Sale amount in cents
  commission        Int       // Commission earned in cents
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, REFUNDED
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([affiliateId])
  @@index([status])
}

// Affiliate payouts
model AffiliatePayout {
  id                String    @id @default(cuid())
  affiliateId       String
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount            Int       // Amount in cents
  method            String    // PAYPAL, BANK_TRANSFER
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  transactionId     String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([affiliateId])
  @@index([status])
}

// Gift subscriptions
model GiftSubscription {
  id                String    @id @default(cuid())
  purchaserId       String
  purchaser         User      @relation("GiftPurchaser", fields: [purchaserId], references: [id], onDelete: Cascade)
  recipientEmail    String
  recipientId       String?
  recipient         User?     @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  message           String?   @db.Text
  plan              String    // monthly, annual
  duration          Int       // Duration in months
  amount            Int       // Price paid in cents
  giftCode          String    @unique
  status            String    @default("PENDING") // PENDING, REDEEMED, EXPIRED
  expiresAt         DateTime
  redeemedAt        DateTime?
  stripePaymentId   String?
  createdAt         DateTime  @default(now())

  @@index([purchaserId])
  @@index([giftCode])
  @@index([recipientEmail])
}

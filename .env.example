# ROA - Roots Online Academy Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (PostgreSQL + Prisma)
# ===========================================
DATABASE_URL="postgresql://neondb_owner:npg_M85wfozhvymE@ep-tiny-lake-ahflwav5-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ===========================================
# CLERK AUTHENTICATION
# ===========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# STRIPE PAYMENTS
# ===========================================
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe webhook secret (from Stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs (create these in Stripe dashboard)
# Monthly: €19.99/month recurring, Annual: €199/year recurring
STRIPE_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_ANNUAL_PRICE_ID=price_xxxxx

# ===========================================
# CLOUDINARY (Video & Image Hosting)
# ===========================================
# Get these from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

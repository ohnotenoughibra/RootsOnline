# ROA - Roots Online Academy Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (PostgreSQL + Prisma)
# ===========================================
# Get a free database from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===========================================
# CLERK AUTHENTICATION
# ===========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# STRIPE PAYMENTS
# ===========================================
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe webhook secret (from Stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs (create these in Stripe dashboard)
# Monthly: €19.99/month recurring, Annual: €199/year recurring
STRIPE_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_ANNUAL_PRICE_ID=price_xxxxx

# Free trial days (set to 0 to disable, 7 for 7-day trial)
FREE_TRIAL_DAYS=0

# ===========================================
# RESEND EMAIL
# ===========================================
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=ROA <noreply@rootsonline.academy>

# SEPA Bank Transfer Details (for manual bank transfers)
NEXT_PUBLIC_SEPA_BANK_NAME=Your Bank Name
NEXT_PUBLIC_SEPA_IBAN=DE89 3704 0044 0532 0130 00
NEXT_PUBLIC_SEPA_BIC=COBADEFFXXX

# ===========================================
# CLOUDINARY (Video & Image Hosting)
# ===========================================
# Get these from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# ===========================================
# UPSTASH REDIS (Rate Limiting)
# ===========================================
# Get these from https://console.upstash.com (free tier available)
# Required for production rate limiting
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ===========================================
# SECURITY
# ===========================================
# REQUIRED: Generate secure random strings for these
# Example: openssl rand -base64 32
CRON_SECRET=your-secure-cron-secret-here
ADMIN_SETUP_SECRET=your-secure-admin-setup-secret-here

# ===========================================
# MONITORING (Optional but Recommended)
# ===========================================
# Sentry - https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# PostHog Analytics - https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# PUSH NOTIFICATIONS (Optional)
# ===========================================
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
